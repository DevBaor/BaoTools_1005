<ui:FluentWindow
    x:Class="BaoToolsGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    xmlns:views="clr-namespace:BaoToolsGui.Views"
    Title="BaoTools"
    Icon="icon.ico"
    Width="1080"
    Height="720"
    MinWidth="760"
    MinHeight="560"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BaoTools">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <Button
                    x:Name="NotificationBellButton"
                    Width="46"
                    Height="48"
                    Margin="0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    Command="{Binding ToggleNotificationCommand}"
                    ToolTip="Notifications"
                    Focusable="False"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Background="Transparent"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                                <Grid
                                    Width="20"
                                    Height="20"
                                    Margin="0,-7,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        Symbol="Alert24"
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <!-- Unread notification indicator badge -->
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,-1,-1,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Fill="#ef4444"
                                        Stroke="#1c1c20"
                                        StrokeThickness="1.5"
                                        Visibility="{Binding HasUnreadNotification, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1FFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#12FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Notification Flyout -->
        <Popup
            x:Name="NotificationPopup"
            IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}"
            PlacementTarget="{Binding ElementName=NotificationBellButton}"
            Placement="Bottom"
            HorizontalOffset="-320"
            VerticalOffset="4"
            AllowsTransparency="True"
            StaysOpen="False">
            <Border
                Width="370"
                MaxHeight="540"
                Background="#23232b"
                BorderBrush="#383844"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Alert24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Static res:Strings.Notification_Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <!-- Refresh / Check now button -->
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Transparent"
                            Padding="4"
                            Width="28"
                            Height="28"
                            Command="{Binding CheckForUpdatesCommand}"
                            ToolTip="{x:Static res:Strings.Notification_CheckForUpdates}"
                            Margin="0,0,4,0">
                            <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="14" />
                        </ui:Button>

                        <!-- Close button -->
                        <ui:Button
                            Grid.Column="2"
                            Appearance="Transparent"
                            Padding="4"
                            Width="28"
                            Height="28"
                            Command="{Binding CloseNotificationCommand}"
                            ToolTip="{x:Static res:Strings.Notification_Close}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" />
                        </ui:Button>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#2e2e38" Margin="-16,0,-16,12" />

                    <!-- Content states -->
                    <Grid Grid.Row="2">
                        <!-- State 1: Checking for updates -->
                        <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" HorizontalAlignment="Center" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Text="{x:Static res:Strings.Notification_Checking}"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- State 2: Active content (when not checking) -->
                        <Grid Visibility="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. Update Available Banner -->
                            <StackPanel
                                Grid.Row="0"
                                Visibility="{Binding HasUpdateContent, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10">
                                <Border
                                    Background="#1A10b981"
                                    BorderBrush="#3310b981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="#10b981" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static res:Strings.Notification_NewUpdateAvailable}" FontWeight="Bold" FontSize="13" Foreground="#10b981" />
                                            <TextBlock Text="{Binding LatestVersion, StringFormat='Version: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding UpdatePublishedAt}" FontSize="11" Foreground="#6b7280" Visibility="{Binding UpdatePublishedAt, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Action buttons -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        Appearance="Primary"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DownloadUpdateCommand}"
                                        IsEnabled="{Binding CanUpdate}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ProgressRing
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                IsIndeterminate="True"
                                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                                            <ui:SymbolIcon
                                                Symbol="ArrowDownload24"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolToVis}}" />
                                            <TextBlock Text="{Binding UpdateButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Appearance="Secondary"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding OpenReleaseNotesCommand}"
                                        Content="{x:Static res:Strings.Notification_ViewNotes}"
                                        Icon="{ui:SymbolIcon Open24}" />
                                </Grid>
                            </StackPanel>

                            <!-- 2. Update History (Lịch sử cập nhật) -->
                            <Grid Grid.Row="1" Margin="0,4,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.Notification_UpdateHistory}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding UpdateHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="#191920"
                                                    BorderBrush="#2c2c36"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Tag badge, Status pill, Date -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#252530" BorderBrush="#383844" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding TagName}" FontWeight="Bold" FontSize="11" Foreground="#60a5fa" />
                                                                </Border>
                                                                <Border
                                                                    Background="#1A10b981"
                                                                    BorderBrush="#3310b981"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="5,1"
                                                                    Margin="0,0,6,0"
                                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{x:Static res:Strings.Notification_Badge_New}" FontSize="10" FontWeight="Bold" Foreground="#10b981" />
                                                                </Border>
                                                                <Border
                                                                    Background="#1A3b82f6"
                                                                    BorderBrush="#333b82f6"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="5,1"
                                                                    Margin="0,0,6,0"
                                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{x:Static res:Strings.Notification_Badge_Current}" FontSize="10" FontWeight="Bold" Foreground="#3b82f6" />
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding PublishedAt}"
                                                                FontSize="10.5"
                                                                Foreground="#6b7280"
                                                                VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- Row 1: Title -->
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Text="{Binding Title}"
                                                            FontWeight="SemiBold"
                                                            FontSize="11.5"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Margin="0,4,0,3"
                                                            TextWrapping="Wrap" />

                                                        <!-- Row 2: Changelog body -->
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Text="{Binding Body}"
                                                            FontSize="11"
                                                            Foreground="#9ca3af"
                                                            LineHeight="15"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 3. Footer status (when up to date) -->
                            <Border
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Padding="8,6"
                                Background="#14141a"
                                BorderBrush="#262630"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="#10b981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding VersionLabel, StringFormat='BaoTools {0}'}"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Static res:Strings.Notification_UpToDate}"
                                        FontSize="11"
                                        Foreground="#10b981"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 4. Footer error state -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Visibility="{Binding HasUpdateError, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Text="{Binding UpdateError}"
                                    FontSize="11"
                                    Foreground="#f87171"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,4" />
                                <ui:Button
                                    Appearance="Secondary"
                                    HorizontalAlignment="Center"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Content="{x:Static res:Strings.Notification_TryAgain}"
                                    Icon="{ui:SymbolIcon ArrowClockwise20}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <!-- App content (nav rail + toasts). Blurred while the first-run welcome overlay is open. -->
            <Grid x:Name="AppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect KernelType="Gaussian" Radius="28" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            <!-- Fluent nav rail. Selection/highlight + page hosting are handled by the control. -->
            <ui:NavigationView
                x:Name="RootNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="False"
                OpenPaneLength="190"
                PaneDisplayMode="Left">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Home}" TargetPageType="{x:Type views:HomeView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Add}" TargetPageType="{x:Type views:DownloadView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Manage}" TargetPageType="{x:Type views:ManageView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Games24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Builds}" TargetPageType="{x:Type views:BuildsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="BranchFork24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Mode}" TargetPageType="{x:Type views:ModeView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Options24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fixes}" TargetPageType="{x:Type views:FixesView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ShieldTask24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_OnlineFixes}" TargetPageType="{x:Type views:OnlineFixesView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Tickets}" TargetPageType="{x:Type views:TicketsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Key24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Plugin}" TargetPageType="{x:Type views:PluginView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="PuzzlePiece24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_RestartSteam}" Click="RestartSteam_Click">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Downloads}" TargetPageType="{x:Type views:DownloadsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}" TargetPageType="{x:Type views:SettingsView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>

                <!-- Guest sign-in CTA + always-visible version tag at the very bottom of the pane -->
                <ui:NavigationView.PaneFooter>
                  <StackPanel>
                    <StackPanel
                        Margin="10,4,10,8"
                        Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding SignInCommand}"
                            Content="{x:Static res:Strings.Nav_SignInDiscord}"
                            Icon="{ui:SymbolIcon Person24}"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing
                                Width="16"
                                Height="16"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="#9ca3af"
                                Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                        </StackPanel>
                        <TextBlock
                            Margin="2,8,0,0"
                            FontSize="11.5"
                            Foreground="#f87171"
                            Text="{Binding SignInError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding SignInError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Bottom line: "Signed in as …" when logged in, else the version tag. -->
                    <TextBlock
                        Margin="12,0,10,8"
                        FontSize="11"
                        Foreground="#6b7280"
                        Text="{Binding FooterStatus}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FooterStatus}" />
                  </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <!-- Bottom-right toasts (attached to ToastService in App.OnStartup). Also hosts the
                 persistent "update ready" prompt with a Restart action. -->
            <ui:SnackbarPresenter
                x:Name="RootSnackbar"
                Margin="0,0,24,18"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" />
            </Grid>

            <!-- First-run welcome overlay (last child = top Z-order; covers the nav + page area). -->
            <views:OnboardingView
                DataContext="{Binding Onboarding}"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
