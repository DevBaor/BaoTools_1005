<Window
    x:Class="BaoToolsGui.Views.UpdateProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    Title="BaoTools - Software Update"
    Width="490"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <!-- Outer margin gives space for DropShadowEffect -->
    <Grid Margin="20">
        <Border
            x:Name="CardBorder"
            Background="#171720"
            BorderBrush="#323242"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24,22,24,22"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="32"
                    ShadowDepth="6"
                    Direction="270"
                    Opacity="0.75"
                    Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Header with Icon, Title, Version Pill, and Close Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border
                        x:Name="IconBadge"
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        CornerRadius="10"
                        Background="#191924"
                        BorderBrush="#36364a"
                        BorderThickness="1">
                        <Grid>
                            <!-- Logo image (default / downloading) -->
                            <Image
                                x:Name="LogoImage"
                                Width="26"
                                Height="26"
                                Source="pack://application:,,,/icon.ico"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <!-- Checkmark symbol icon (shown on success) -->
                            <ui:SymbolIcon
                                x:Name="SuccessIcon"
                                Symbol="Checkmark24"
                                FontSize="20"
                                Foreground="#10b981"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />

                            <!-- Error symbol icon (shown on failure) -->
                            <ui:SymbolIcon
                                x:Name="ErrorIcon"
                                Symbol="Dismiss24"
                                FontSize="20"
                                Foreground="#ef4444"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Title & Version Pill -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="HeaderBlock"
                            Text="{x:Static res:Strings.UpdateDialog_DownloadingHeader}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#f4f4f5" />

                        <!-- Version pill tag -->
                        <Border
                            x:Name="VersionPill"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Background="#1c2536"
                            BorderBrush="#2563eb44"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,2">
                            <TextBlock
                                x:Name="VersionTagText"
                                Text="{x:Static res:Strings.UpdateDialog_DownloadingStatus}"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="#60a5fa" />
                        </Border>
                    </StackPanel>

                    <!-- Close (X) button -->
                    <Button
                        x:Name="BtnCloseX"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCloseX_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="CloseBorder"
                                    Background="Transparent"
                                    CornerRadius="6">
                                    <ui:SymbolIcon
                                        Symbol="Dismiss20"
                                        FontSize="14"
                                        Foreground="#71717a"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="#22ffffff" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 1: Content Area (Full width) -->
                <Grid Grid.Row="1" Margin="0,18,0,20">
                    <!-- 1. Downloading State -->
                    <StackPanel x:Name="PanelDownloading" Visibility="Visible">
                        <TextBlock
                            x:Name="DownloadingMessageBlock"
                            Text="{x:Static res:Strings.Notification_Downloading}"
                            FontSize="13"
                            Foreground="#a1a1aa"
                            TextWrapping="Wrap"
                            LineHeight="20" />

                        <!-- Full-width Progress Bar -->
                        <Grid Margin="0,14,0,0">
                            <ProgressBar
                                x:Name="DownloadProgressBar"
                                Height="8"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                IsIndeterminate="True"
                                BorderThickness="0"
                                Background="#232332"
                                Foreground="#3b82f6" />
                        </Grid>

                        <!-- Progress info numbers -->
                        <Grid Margin="0,7,0,0">
                            <TextBlock
                                x:Name="DownloadDetailText"
                                Text="{x:Static res:Strings.Notification_Downloading}"
                                FontSize="12"
                                Foreground="#71717a"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                x:Name="PercentText"
                                Text="0%"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="#e4e4e7"
                                HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- 2. Ready to Restart State -->
                    <StackPanel x:Name="PanelReady" Visibility="Collapsed">
                        <!-- Success Banner Card -->
                        <Border
                            Background="#10251c"
                            BorderBrush="#1b4d36"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Symbol="CheckmarkCircle24"
                                    FontSize="22"
                                    Foreground="#10b981"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="ReadyTitleBlock"
                                        Text="{x:Static res:Strings.UpdateDialog_ReadyHeader}"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#ecfdf5" />
                                    <TextBlock
                                        x:Name="ReadyDetailBlock"
                                        Margin="0,3,0,0"
                                        Text="{x:Static res:Strings.UpdateDialog_ReadyStatus}"
                                        FontSize="12"
                                        Foreground="#6ee7b7" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Clear instructions below -->
                        <TextBlock
                            x:Name="ReadyMessageBlock"
                            Margin="0,12,0,0"
                            Text="{x:Static res:Strings.UpdateDialog_ReadySub}"
                            FontSize="13"
                            Foreground="#d4d4d8"
                            TextWrapping="Wrap"
                            LineHeight="20" />
                    </StackPanel>


                    <!-- 3. Failed State -->
                    <StackPanel x:Name="PanelFailed" Visibility="Collapsed">
                        <Border
                            Background="#2b1414"
                            BorderBrush="#592323"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Symbol="DismissCircle24"
                                    FontSize="22"
                                    Foreground="#ef4444"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Static res:Strings.UpdateDialog_FailedHeader}"
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="#fecaca" />
                                    <TextBlock
                                        x:Name="FailedMessageBlock"
                                        Margin="0,3,0,0"
                                        Text="Đã xảy ra lỗi trong quá trình tải bản cập nhật."
                                        FontSize="12"
                                        Foreground="#fca5a5"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="{x:Static res:Strings.UpdateDialog_FailedSub}"
                            FontSize="12.5"
                            Foreground="#a1a1aa"
                            TextWrapping="Wrap"
                            LineHeight="19" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Action Buttons -->
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <!-- Cancel / Later Button -->
                    <Button
                        x:Name="BtnSecondary"
                        Height="34"
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Padding="16,0"
                        FontSize="12.5"
                        FontWeight="Medium"
                        Foreground="#e4e4e7"
                        Background="#232330"
                        BorderBrush="#38384d"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnSecondary_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#2e2e40" />
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4e4e66" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1b1b24" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Primary Action Button (Restart / Open Browser) -->
                    <Button
                        x:Name="BtnPrimary"
                        Height="34"
                        MinWidth="135"
                        Padding="18,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#ffffff"
                        Background="#2563eb"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnPrimary_Click"
                        Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                x:Name="BtnPrimaryIcon"
                                Symbol="ArrowClockwise20"
                                FontSize="15"
                                Foreground="#ffffff"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="BtnPrimaryText"
                                Text="{x:Static res:Strings.UpdateDialog_RestartNow}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
