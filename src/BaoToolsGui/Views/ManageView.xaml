<UserControl
    x:Class="BaoToolsGui.Views.ManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:ManageViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Filter/sort ComboBox item display: shows the localized label while the bound value stays the
             English key (so ManageViewModel's switch/equality logic is untouched). -->
        <DataTemplate x:Key="FilterOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
        </DataTemplate>

        <!-- Modern Dark Gaming CheckBox for Filter Sidebar -->
        <Style x:Key="ModernFilterCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="Box"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    x:Name="CheckIcon"
                                    Symbol="Checkmark16"
                                    FontSize="10"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset Filter Button Style -->
        <Style x:Key="ResetFilterButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="B"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Header & Tools -->
            <RowDefinition Height="Auto" /> <!-- 1: Subheader & Quick Pills -->
            <RowDefinition Height="*" />    <!-- 2: Content (Grid + Sidebar) -->
            <RowDefinition Height="Auto" /> <!-- 3: Footer (Pagination) -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Top Header & Tools Bar ──────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title + Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock
                    FontSize="23"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static res:Strings.Manage_Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static res:Strings.Manage_Subtitle}" />
            </StackPanel>

            <!-- Action Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search Box -->
                <ui:TextBox
                    Width="230"
                    Height="32"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Filter Toggle Button -->
                <Button
                    Margin="8,0,0,0"
                    Padding="10,0"
                    Height="32"
                    Cursor="Hand"
                    Command="{Binding ToggleFilterPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="B"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Filter24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.Manage_Filters}" FontSize="11.5" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Sort Pill Button matching Filter button -->
                <Button
                    Margin="8,0,0,0"
                    Padding="10,0"
                    Height="32"
                    Cursor="Hand"
                    Click="SortButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="B"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSort24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.Manage_Sort_Title}" FontSize="11.5" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.Manage_Sort_RecentlyAdded}" Command="{Binding SetSortCommand}" CommandParameter="Recently added" />
                            <MenuItem Header="{x:Static res:Strings.Manage_Sort_NameAZ}" Command="{Binding SetSortCommand}" CommandParameter="Name (A–Z)" />
                            <MenuItem Header="{x:Static res:Strings.Manage_Sort_ReleaseNewest}" Command="{Binding SetSortCommand}" CommandParameter="Release date (newest)" />
                            <MenuItem Header="{x:Static res:Strings.Manage_Sort_Metacritic}" Command="{Binding SetSortCommand}" CommandParameter="Metacritic" />
                            <MenuItem Header="{x:Static res:Strings.Manage_Sort_MostReviewed}" Command="{Binding SetSortCommand}" CommandParameter="Most reviewed" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Refresh Button -->
                <Button
                    Margin="8,0,0,0"
                    Width="32"
                    Height="32"
                    Cursor="Hand"
                    Command="{Binding RefreshCommand}"
                    ToolTip="{x:Static res:Strings.Manage_Refresh}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="B"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- + Add Game Button (Dynamic Accent) -->
                <Button
                    Margin="8,0,0,0"
                    Padding="12,0"
                    Height="32"
                    Cursor="Hand"
                    Command="{Binding AddGameCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="B" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,6,0" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.Home_AddGame}" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Row 1: Subheader & Quick Genre Pills ────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Game count -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,7">
                    <ui:SymbolIcon
                        Symbol="Games24"
                        FontSize="14"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding TotalGamesLabel}"
                        FontWeight="Bold"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Quick Genre Pills (Horizontal) -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding QuickPillItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,4"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.QuickFilterGenreCommand, ElementName=Root}"
                                    CommandParameter="{Binding Key}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="PillBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="14"
                                                            Padding="{TemplateBinding Padding}">
                                                            <TextBlock
                                                                x:Name="PillText"
                                                                Text="{Binding Label}"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Foreground="{TemplateBinding Foreground}"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource StringEqualityMulti}">
                                                                        <Binding Path="Key" />
                                                                        <Binding Path="DataContext.SelectedQuickPill" ElementName="Root" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF" />
                                                                <Setter TargetName="PillText" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Right: View switch (Grid / List) & Pending Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,2">
                <!-- Pending Details indicator if fetching -->
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasPendingDetails, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" VerticalAlignment="Center" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding FilterPendingText}" />
                </StackPanel>

                <!-- View switch icons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.Manage_View}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <!-- Grid View Button -->
                    <Button
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Padding="0"
                        Cursor="Hand"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="Grid"
                        ToolTip="{x:Static res:Strings.Manage_View_Grid}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="B"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGridView, ElementName=Root}" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsGridView, ElementName=Root}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <ui:SymbolIcon Symbol="Grid24" FontSize="13" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <!-- List View Button -->
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Cursor="Hand"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="List"
                        ToolTip="{x:Static res:Strings.Manage_View_List}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="B"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGridView, ElementName=Root}" Value="False">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsGridView, ElementName=Root}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="13" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Content (Game Cards Grid + Collapsible Filter Sidebar) ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Game Cards Area -->
            <Grid Grid.Column="0">
                <!-- Virtualized scrolling grid of all tiles (4 cards per row, 158x208px) -->
                <vwp:VirtualizingItemsControl
                    x:Name="TileScroller"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.CacheLengthUnit="Page"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Standard">
                    <vwp:VirtualizingItemsControl.Style>
                        <Style TargetType="vwp:VirtualizingItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowItems}" Value="True" />
                                        <Condition Binding="{Binding IsGridView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </vwp:VirtualizingItemsControl.Style>
                    <vwp:VirtualizingItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel
                                Orientation="Horizontal"
                                SpacingMode="Uniform"
                                StretchItems="False" />
                        </ItemsPanelTemplate>
                    </vwp:VirtualizingItemsControl.ItemsPanel>
                    <vwp:VirtualizingItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="TileRoot"
                                Width="170"
                                Height="220"
                                Margin="0,0,0,12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                CornerRadius="10"
                                DataContextChanged="Tile_DataContextChanged"
                                Loaded="Tile_Loaded"
                                MouseLeftButtonUp="Tile_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_ViewDetails}"
                                            Icon="{ui:SymbolIcon Info24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ManageBuildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_ManageBuild}"
                                            Icon="{ui:SymbolIcon BranchFork24}" />
                                        <Separator />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.UpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_Update}"
                                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.RemoveDrmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                                            Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ExtractTicketsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_ExtractTickets}"
                                            Icon="{ui:SymbolIcon Key24}" />
                                        <Separator />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.OpenStorePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_OpenStore}"
                                            Icon="{ui:SymbolIcon Globe24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.OpenInSteamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                            Icon="{ui:SymbolIcon Open24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Manage_Action_Reveal}"
                                            Icon="{ui:SymbolIcon FolderOpen24}" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static res:Strings.Common_CopyAppId}"
                                            Icon="{ui:SymbolIcon Copy24}" />
                                        <Separator />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#f87171"
                                            Header="{x:Static res:Strings.Manage_DeleteThisLua}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <!-- Tag carries the page VM so the ContextMenu can reach its commands -->
                                <Border.Tag>
                                    <Binding ElementName="Root" Path="DataContext" />
                                </Border.Tag>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Cover Area (Height 98, CornerRadius 8, Inset Margin 5) -->
                                    <Border
                                        Grid.Row="0"
                                        Height="98"
                                        Margin="5,5,5,0"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Image
                                                Source="{Binding Cover}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- Selection Checkbox overlay -->
                                            <ui:Button
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="5"
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                Click="ToggleSelect_Click"
                                                ToolTip="{x:Static res:Strings.Manage_Select}">
                                                <ui:Button.Style>
                                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="10" Foreground="#FFFFFF" />
                                            </ui:Button>

                                            <!-- Status Badge: Installed -->
                                            <Border
                                                Margin="0,5,5,0"
                                                Padding="5,1.5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="#2010B981"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    Text="{x:Static res:Strings.Manage_Status_Installed}"
                                                    FontSize="8.5"
                                                    FontWeight="Bold"
                                                    Foreground="#10B981"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Status Badge: Not Installed -->
                                            <Border
                                                Margin="0,5,5,0"
                                                Padding="5,1.5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock
                                                    Text="{x:Static res:Strings.Manage_Status_NotInstalled}"
                                                    FontSize="8.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Card Body Info & Action Buttons -->
                                    <Grid Grid.Row="1" Margin="7,5,7,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Game Title -->
                                        <TextBlock
                                            Grid.Row="0"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            MaxHeight="32"
                                            LineHeight="15"
                                            VerticalAlignment="Top" />

                                        <!-- Category & App ID Badge -->
                                        <Grid Grid.Row="1" Margin="0,3.5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon
                                                    Symbol="Games24"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Margin="0,0,3.5,0"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding LocalizedGenreText}"
                                                    FontSize="9.5"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    MaxWidth="82"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- App ID Badge -->
                                            <Border
                                                Grid.Column="1"
                                                Background="#18FFFFFF"
                                                CornerRadius="3.5"
                                                Padding="4.5,1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding AppId}"
                                                    FontSize="9"
                                                    FontFamily="Consolas, Segoe UI"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Date Added Row -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                                            <ui:SymbolIcon
                                                Symbol="Clock24"
                                                FontSize="9.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Margin="0,0,3.5,0"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding AddedDateText}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Date Released Row (when available) -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2.5,0,0" Visibility="{Binding HasReleaseLabel, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon
                                                Symbol="CalendarLtr24"
                                                FontSize="9.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Margin="0,0,3.5,0"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding ReleaseLabel}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Action Buttons: Manage + Kebab Menu -->
                                        <Grid Grid.Row="5" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Manage button (Dynamic Accent) -->
                                            <Button
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                Height="28"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenDetailCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="B" Property="Opacity" Value="0.9" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="B" Property="Opacity" Value="0.75" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="11" Margin="0,0,4,0" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{x:Static res:Strings.Nav_Manage}"
                                                        FontWeight="SemiBold"
                                                        FontSize="10.5"
                                                        Foreground="#FFFFFF"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Context menu kebab button -->
                                            <Button
                                                Grid.Column="1"
                                                Margin="3,0,0,0"
                                                Width="20"
                                                Height="28"
                                                Tag="{Binding DataContext, ElementName=Root}"
                                                Cursor="Hand"
                                                Click="CardMenuButton_Click"
                                                ToolTip="{x:Static res:Strings.Manage_Action_ViewDetails}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="B" Background="Transparent" CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <ui:SymbolIcon
                                                    Symbol="MoreVertical24"
                                                    FontSize="14"
                                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </vwp:VirtualizingItemsControl.ItemTemplate>
                </vwp:VirtualizingItemsControl>

                <!-- List View (Table layout when IsGridView is false) -->
                <ScrollViewer
                    x:Name="ListScroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowItems}" Value="True" />
                                        <Condition Binding="{Binding IsGridView}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    DataContextChanged="Tile_DataContextChanged"
                                    Loaded="Tile_Loaded"
                                    MouseLeftButtonUp="Tile_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="56" />
                                            <Setter Property="Padding" Value="10,6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Height" Value="64" />
                                                    <Setter Property="Padding" Value="12,8" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Tag>
                                        <Binding ElementName="Root" Path="DataContext" />
                                    </Border.Tag>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover -->
                                        <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="86" />
                                                    <Setter Property="Height" Value="40" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                            <Setter Property="Width" Value="100" />
                                                            <Setter Property="Height" Value="46" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Title & Metadata -->
                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                                <Setter Property="FontSize" Value="14" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding AppIdText}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="  •  " />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding LocalizedGenreText}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="  •  " />
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding AddedDateText}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Background="#2010B981"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{x:Static res:Strings.Manage_Status_Installed}" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                                            </Border>
                                            <Border
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{x:Static res:Strings.Manage_Status_NotInstalled}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions: Manage + More -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button
                                                Padding="12,0"
                                                Cursor="Hand"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                BorderThickness="0"
                                                Foreground="#FFFFFF"
                                                Command="{Binding DataContext.OpenDetailCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Height" Value="26" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                                <Setter Property="Height" Value="30" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="11" Margin="0,0,4,0" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{x:Static res:Strings.Nav_Manage}" FontWeight="SemiBold" FontSize="10.5" Foreground="#FFFFFF" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Margin="4,0,0,0"
                                                Width="22"
                                                Height="26"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CardMenuButton_Click">
                                                <ui:SymbolIcon Symbol="MoreVertical24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading state -->
                <StackPanel
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Manage_LoadingGames}" />
                </StackPanel>

                <!-- Empty state -->
                <StackPanel
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Games24" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding EmptyMessage}" />
                    <ui:Button
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Content="{x:Static res:Strings.Manage_ClearFilters}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Multi-selection batch action bar -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Padding="14,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding SelectionLabel}" />
                        <ui:Button
                            Margin="12,0,6,0"
                            Appearance="Secondary"
                            Command="{Binding ClearSelectionCommand}"
                            Content="{x:Static res:Strings.Manage_Clear}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <ui:Button
                            Appearance="Danger"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="{x:Static res:Strings.Manage_DeleteSelected}"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Column 1: Filter Sidebar matching Mockup media_1789966570765.jpg -->
            <Border
                Grid.Column="1"
                Margin="10,0,0,0"
                Padding="10,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="140" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Width" Value="160" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Section: PLATFORM -->
                        <TextBlock
                            Text="{x:Static res:Strings.Manage_Filter_Platform}"
                            FontSize="9.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,6" />
                        <CheckBox Content="Steam" IsChecked="{Binding FilterPlatformSteam}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Epic Games" IsChecked="{Binding FilterPlatformEpic}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Other" IsChecked="{Binding FilterPlatformOther}" Style="{StaticResource ModernFilterCheckBox}" />

                        <!-- Section: STATUS -->
                        <TextBlock
                            Text="{x:Static res:Strings.Manage_Filter_Status}"
                            FontSize="9.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,12,0,6" />
                        <CheckBox Content="{x:Static res:Strings.Manage_Status_Installed}" IsChecked="{Binding FilterStatusInstalled}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="{x:Static res:Strings.Manage_Status_NotInstalled}" IsChecked="{Binding FilterStatusNotInstalled}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="{x:Static res:Strings.Manage_Status_MissingFiles}" IsChecked="{Binding FilterStatusMissingFiles}" Style="{StaticResource ModernFilterCheckBox}" />

                        <!-- Section: GENRE -->
                        <TextBlock
                            Text="{x:Static res:Strings.Manage_Filter_GenreUpper}"
                            FontSize="9.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,12,0,6" />
                        <CheckBox Content="Action" IsChecked="{Binding FilterGenreAction}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="RPG" IsChecked="{Binding FilterGenreRpg}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Strategy" IsChecked="{Binding FilterGenreStrategy}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Survival" IsChecked="{Binding FilterGenreSurvival}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Racing" IsChecked="{Binding FilterGenreRacing}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Simulation" IsChecked="{Binding FilterGenreSimulation}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Sports" IsChecked="{Binding FilterGenreSports}" Style="{StaticResource ModernFilterCheckBox}" />
                        <CheckBox Content="Other" IsChecked="{Binding FilterGenreOther}" Style="{StaticResource ModernFilterCheckBox}" />

                        <!-- RESET FILTERS Button -->
                        <Button
                            Margin="0,16,0,2"
                            Height="28"
                            Style="{StaticResource ResetFilterButton}"
                            Command="{Binding ClearFiltersCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Strings.Manage_ClearFiltersUpper}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Row 3: Pagination Footer ────────────────────────────────────── -->
        <Grid
            Grid.Row="3"
            Margin="0,10,0,0"
            Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Showing summary count (e.g. Showing 1 – 12 of 12 games) -->
            <TextBlock
                Grid.Column="0"
                Text="{Binding ShowingSummary}"
                FontSize="11.5"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />

            <!-- Right: Pagination Buttons (< [1] >) -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">

                <!-- Previous button (<) -->
                <Button
                    Width="28"
                    Height="28"
                    Margin="0,0,5,0"
                    Cursor="Hand"
                    Command="{Binding PrevPageCommand}"
                    IsEnabled="{Binding CanGoPrev}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="B"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="11" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>

                <!-- Dynamic Page Numbers -->
                <ItemsControl ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,5,0">
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button
                                    Width="28"
                                    Height="28"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="B"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityMulti}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Next button (>) -->
                <Button
                    Width="28"
                    Height="28"
                    Cursor="Hand"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="B"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Detail flyout: dim scrim + slide-in panel from the right ──── -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Panel.ZIndex="1000"
            Margin="-16,-14,-16,-12"
            Background="#99000000"
            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <!-- Click scrim to dismiss -->
            <Border Background="Transparent" MouseLeftButtonUp="Scrim_Click" />
            <Border
                Width="420"
                HorizontalAlignment="Right"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Direction="180" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <Grid Margin="20,16,16,16" DataContext="{Binding SelectedTile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Manage_GameDetails_Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button
                            HorizontalAlignment="Right"
                            Appearance="Transparent"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Cursor="Hand"
                            Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="{x:Static res:Strings.Manage_CloseTooltip}" />
                    </Grid>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Cover + title -->
                            <Border
                                Height="165"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Name}"
                                TextWrapping="Wrap" />

                            <Button
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="{x:Static res:Strings.Manage_CopyAppIdTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                                    <ui:SymbolIcon
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Copy24" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding AddedReleaseLabel}" />

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,14,0,14" />

                            <!-- Actions -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{x:Static res:Strings.Manage_ActionsHeader}" />

                            <!-- Steamless progress -->
                            <ProgressBar
                                Height="3"
                                Margin="0,0,0,8"
                                IsIndeterminate="{Binding DataContext.IsProgressIndeterminate, ElementName=Root}"
                                Maximum="100"
                                Value="{Binding DataContext.Progress, ElementName=Root}"
                                Visibility="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}" />

                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding DataContext.ManageBuildCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_ManageBuild}"
                                Icon="{ui:SymbolIcon BranchFork24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.UpdateCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_Update}"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.EditLaunchOptionsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_LaunchOptions}"
                                Icon="{ui:SymbolIcon Play24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.RemoveDrmCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_Action_RemoveDrm}"
                                Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                            <UniformGrid Margin="0,8,0,0" Columns="2" Rows="2">
                                <ui:Button
                                    Margin="0,0,4,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenStorePageCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Manage_Action_OpenStore}"
                                    Icon="{ui:SymbolIcon Globe24}" />
                                <ui:Button
                                    Margin="4,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenInSteamCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Manage_Action_OpenInSteam}"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <ui:Button
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.RevealFileCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Manage_Action_Reveal}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                <ui:Button
                                    Margin="4,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="{x:Static res:Strings.Manage_Action_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}" />
                            </UniformGrid>
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="{x:Static res:Strings.Manage_DeleteThisLua}"
                                Foreground="#f87171"
                                Icon="{ui:SymbolIcon Delete24}" />

                            <!-- Game info from cached appdetails -->
                            <StackPanel
                                Margin="0,16,0,0"
                                DataContext="{Binding DataContext.Overview, ElementName=Root}"
                                Visibility="{Binding HasAnything, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,14" />
                                <Grid>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{x:Static res:Strings.Manage_AboutHeader}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ToggleDescriptionLanguageCommand, ElementName=Root}"
                                        Visibility="{Binding DataContext.CanToggleDescriptionLanguage, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="B"
                                                    Background="#15A855F7"
                                                    BorderBrush="#40A855F7"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#25A855F7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Translate24" FontSize="11" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DataContext.DescriptionLanguageToggleText, ElementName=Root}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    LineHeight="18"
                                    Text="{Binding DataContext.EffectiveDescription, ElementName=Root}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                <!-- Developer / publisher -->
                                <Grid Margin="0,12,0,0" Visibility="{Binding HasDeveloper, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static res:Strings.Manage_Info_Developer}"
                                        Margin="0,0,12,0" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding DeveloperLabel}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,6,0,0" Visibility="{Binding HasDistinctPublisher, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static res:Strings.Manage_Info_Publisher}"
                                        Margin="0,0,12,0" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding PublisherLabel}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!-- Genre pills -->
                                <ItemsControl
                                    Margin="0,12,0,0"
                                    ItemsSource="{Binding LocalizedGenres}"
                                    Visibility="{Binding HasGenres, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,6,6"
                                                Padding="7,2"
                                                Background="#20FFFFFF"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
