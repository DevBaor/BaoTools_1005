<UserControl
    x:Class="BaoToolsGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Modern card container for settings sections -->
        <Style x:Key="ModernSettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
        </Style>

        <!-- Subtle row divider within a card -->
        <Style x:Key="ModernRowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>

        <!-- Uppercase section label above each card group -->
        <Style x:Key="ModernSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,28,0,8" />
        </Style>
    </UserControl.Resources>

    <!-- Single smooth scrollable page with no tabs and no sidebar -->
    <ScrollViewer
        x:Name="PageScroller"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            MaxWidth="980"
            Margin="28,22,28,40"
            HorizontalAlignment="Center">

            <!-- ── 1. Page Header ────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static res:Strings.Settings_Title}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static res:Strings.Settings_Subtitle}" />
            </StackPanel>

            <!-- ── 2. ACCOUNT & SERVICES ──────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_Account}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <StackPanel>
                    <!-- Signed-in user profile -->
                    <StackPanel Visibility="{Binding IsRealUser, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- User Avatar -->
                            <Border
                                Width="46"
                                Height="46"
                                CornerRadius="23"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <ui:SymbolIcon
                                        Symbol="Person24"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Ellipse Width="46" Height="46">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Border>

                            <!-- User Details -->
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DisplayName}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Email}" />
                                <Border
                                    Margin="0,5,0,0"
                                    Padding="7,2"
                                    HorizontalAlignment="Left"
                                    Background="#208b5cf6"
                                    BorderBrush="#408b5cf6"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding HasQuotaText, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#a78bfa"
                                        Text="{Binding QuotaText}" />
                                </Border>
                            </StackPanel>

                            <!-- Sign Out Button -->
                            <ui:Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Command="{Binding SignOutCommand}"
                                Content="{x:Static res:Strings.Settings_SignOut}"
                                Icon="{ui:SymbolIcon SignOut24}" />
                        </Grid>

                        <!-- Bot-provisioned re-link banner -->
                        <Border
                            Margin="0,14,0,0"
                            Padding="14"
                            Background="#1Aeab308"
                            BorderBrush="#33eab308"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowBotLinkBanner, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_BotLink_Title}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_BotLink_Body}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        Appearance="Transparent"
                                        Command="{Binding DismissBotBannerCommand}"
                                        Content="✕" />
                                </Grid>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <ui:TextBox
                                        Width="130"
                                        CharacterCasing="Upper"
                                        MaxLength="6"
                                        PlaceholderText="{x:Static res:Strings.Settings_BotCode_Placeholder}"
                                        Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Appearance="Primary"
                                        Command="{Binding SignInWithCodeCommand}"
                                        Content="{x:Static res:Strings.Settings_BotCode_Redeem}"
                                        Icon="{ui:SymbolIcon Link24}"
                                        IsEnabled="{Binding CanRedeemCode}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="11.5"
                                    Foreground="#f87171"
                                    Text="{Binding CodeError}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Guest mode UI -->
                    <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <!-- Login Required Redirect Banner -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12"
                            Background="#1A3b82f6"
                            BorderBrush="#333b82f6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding LoginRequiredMessage, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Foreground="#60a5fa" Symbol="Info24" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding LoginRequiredMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Command="{Binding DismissLoginRequiredCommand}"
                                    Content="✕" />
                            </Grid>
                        </Border>

                        <!-- Guest sign in row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_BrowsingAsGuest}" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_GuestHint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Appearance="Primary"
                                Command="{Binding SignInCommand}"
                                Content="{x:Static res:Strings.Settings_SignInDiscord}"
                                Icon="{ui:SymbolIcon Person24}" />
                        </Grid>

                        <Border Style="{StaticResource ModernRowDivider}" />

                        <!-- Discord Bot Code Redeem -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_BotCode_Redeem}" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_BotCode_Hint}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ui:TextBox
                                    Width="120"
                                    CharacterCasing="Upper"
                                    MaxLength="6"
                                    PlaceholderText="{x:Static res:Strings.Settings_BotCode_Placeholder}"
                                    Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding SignInWithCodeCommand}"
                                    Content="{x:Static res:Strings.Settings_BotCode_Redeem}"
                                    Icon="{ui:SymbolIcon Key24}"
                                    IsEnabled="{Binding CanRedeemCode}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11.5"
                            Foreground="#f87171"
                            Text="{Binding CodeError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Row Divider separating Account and Hubcap -->
                    <Border Style="{StaticResource ModernRowDivider}" Margin="0,18" />

                    <!-- Hubcap API Integration -->
                    <StackPanel>
                        <!-- Service Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Key24" FontSize="15" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_Section_Hubcap}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Active Status Badge when Configured -->
                            <Border
                                HorizontalAlignment="Right"
                                Padding="7,2"
                                Background="#1A10b981"
                                BorderBrush="#4010b981"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#34d399" Text="{x:Static res:Strings.Settings_HubcapActive}" />
                            </Border>
                        </Grid>

                        <!-- When Key is Configured: Stats + Refresh + Clear -->
                        <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource BoolToVis}}">
                            <Border
                                Padding="14,12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding ShowHubcapStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ProgressBar
                                        Height="6"
                                        IsIndeterminate="{Binding HubcapStatsPending}"
                                        Maximum="1"
                                        Minimum="0"
                                        Value="{Binding HubcapUsagePercent, Mode=OneWay}" />
                                    <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding HubcapStatsText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding RefreshHubcapStatsCommand}"
                                    Content="{x:Static res:Strings.Settings_HubcapRefresh}"
                                    Icon="{ui:SymbolIcon ArrowSync24}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Command="{Binding ClearHubcapKeyCommand}"
                                    Content="{x:Static res:Strings.Settings_HubcapClear}"
                                    Icon="{ui:SymbolIcon Dismiss24}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- When Key is NOT Configured: Input & Validation -->
                        <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_HubcapKey_Hint}" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    FontFamily="Consolas"
                                    PlaceholderText="{x:Static res:Strings.Settings_HubcapKeyPlaceholder}"
                                    Text="{Binding HubcapKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding ValidateAndSaveHubcapKeyCommand}"
                                    Content="{x:Static res:Strings.Settings_HubcapValidate}"
                                    IsEnabled="{Binding CanEditHubcapKey}" />
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{Binding HubcapKeyStatusColor}"
                                Text="{Binding HubcapKeyStatus}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HubcapKeyStatus, Converter={StaticResource NullToCollapsed}}" />

                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Static res:Strings.Settings_HubcapGetKey}" />
                                <Hyperlink Command="{Binding OpenHubcapCommand}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">hubcapmanifest.com</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 3. APPEARANCE & GENERAL ────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_Appearance}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <StackPanel>
                    <!-- Theme Selector Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_Theme}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_Theme_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Width="230"
                            MinHeight="35"
                            MaxDropDownHeight="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Dual-Color Theme Swatch Badge (Base tone + Accent tone) -->
                                        <Grid Width="20" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="10" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3,0,0,3">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding BackgroundColor}" />
                                                </Border.Background>
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="0,3,3,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding AccentColor}" />
                                                </Border.Background>
                                            </Border>
                                            <Border
                                                Grid.ColumnSpan="2"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="#40FFFFFF" />
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding Display}"
                                            FontSize="12.5"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- Language Selector Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_Language}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_Language_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Width="230"
                            MinHeight="35"
                            MaxDropDownHeight="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Country Flag or System Default Globe -->
                                        <Grid Width="20" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <!-- Fallback Globe for System default -->
                                            <ui:SymbolIcon
                                                Symbol="Globe16"
                                                FontSize="14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Visibility="{Binding HasFlag, Converter={StaticResource InverseBoolToVis}}" />

                                            <!-- Country Flag with subtle rounded border -->
                                            <Border
                                                Width="20"
                                                Height="14"
                                                CornerRadius="2.5"
                                                BorderThickness="1"
                                                BorderBrush="#35FFFFFF"
                                                ClipToBounds="True"
                                                Visibility="{Binding HasFlag, Converter={StaticResource BoolToVis}}">
                                                <Image
                                                    Source="{Binding FlagIcon}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding Display}"
                                            FontSize="12.5"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- DNS Resolution Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_Dns}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_Dns_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Width="230"
                            MinHeight="35"
                            MaxDropDownHeight="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding DnsModeOptions}"
                            SelectedItem="{Binding SelectedDnsMode}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 4. BEHAVIOR & STARTUP ──────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_Install}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <StackPanel>
                    <!-- Auto Update Apps Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_AutoUpdateApps}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_AutoUpdateApps_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AutoUpdateApps, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- FastFetch Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Add_FastFetch}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Add_FastFetch_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding FastFetch, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- Start with Windows Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_StartWithWindows_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- Start with Steam Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_StartWithSteam}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_StartWithSteam_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithSteam, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource ModernRowDivider}" />

                    <!-- Minimize to Tray Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_MinimizeToTray}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_MinimizeToTray_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 5. STEAM ──────────────────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_Steam}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <StackPanel>
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_SteamLocation}" />
                    <TextBlock Margin="0,3,0,10" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SteamSource}" />

                    <!-- Path & Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SteamPath, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Appearance="Secondary"
                            Command="{Binding OverrideSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Appearance="Secondary"
                            Command="{Binding OpenSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Command="{Binding ClearSteamOverrideCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSteamOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Warning if steam path is unverified -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="12,10"
                        Background="#1Af87171"
                        BorderBrush="#33f87171"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding SteamWarning, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#f87171" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="#f87171" Text="{Binding SteamWarning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── 6. BAOTOOLS ASSISTANT ─────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_AiAssistant}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Bot24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.AiChat_Title}" VerticalAlignment="Center" />
                                <Border
                                    Margin="10,0,0,0"
                                    Padding="7,2"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_AiAssistant_LocalOffline}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                LineHeight="17"
                                Text="{x:Static res:Strings.Settings_AiAssistant_CardDesc}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                LineHeight="16"
                                Text="{x:Static res:Strings.Settings_AiAssistant_Enable_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding EnableAiAssistant, Mode=TwoWay}" />
                    </Grid>


                </StackPanel>
            </Border>

            <!-- ── 7. COMMUNITY ──────────────────────────────────────────── -->
            <TextBlock
                Style="{StaticResource ModernSectionLabel}"
                Text="{x:Static res:Strings.Settings_Section_Community}" />

            <Border Style="{StaticResource ModernSettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static res:Strings.Settings_DonateKeys}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Settings_DonateKeys_Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding DonateKeys, Mode=TwoWay}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
