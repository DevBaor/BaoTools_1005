<Page x:Class="BaoToolsGui.Views.OnlineFixesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
      xmlns:res="clr-namespace:BaoToolsGui.Resources"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:OnlineFixesViewModel, IsDesignTimeCreatable=False}"
      Title="Online Fixes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Nav_OnlineFixes}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{x:Static res:Strings.OnlineFixes_Help}" Foreground="#9ca3af" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
            </StackPanel>
            
            <ui:TextBox Grid.Column="1" Width="250" VerticalAlignment="Top" 
                        PlaceholderText="{x:Static res:Strings.OnlineFixes_Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,16">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OnlineFixGameCardVm}">
                            <ui:Card Margin="0,0,16,16" Width="280"  VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="132" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Cover Image -->
                                    <Border CornerRadius="4,4,0,0" ClipToBounds="True" Background="#2d2d2d">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Row="1" Margin="12">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding AppId}" Foreground="#9ca3af" FontSize="12" Margin="0,0,0,12" />
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="{x:Static res:Strings.OnlineFixes_Download}" Icon="{ui:SymbolIcon Globe24}" HorizontalAlignment="Stretch"
                                                       Command="{Binding DataContext.DownloadFixCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Grid.Column="2" Content="{x:Static res:Strings.OnlineFixes_Install}" Appearance="Primary" Icon="{ui:SymbolIcon FolderZip24}" HorizontalAlignment="Stretch"
                                                       Command="{Binding DataContext.InstallFixCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Page>







