<UserControl
    x:Class="BaoToolsGui.Views.OnlineFixesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:OnlineFixesViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Nav_OnlineFixes}" />
                <Border
                    Margin="12,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="#1438bdf8"
                    BorderBrush="#3338bdf8"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Globe16" Foreground="#38bdf8" FontSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="online-fix.me" FontSize="11.5" FontWeight="SemiBold" Foreground="#38bdf8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Content="{x:Static res:Strings.Manage_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Appearance="Secondary" />
        </Grid>

        <!-- Search Bar -->
        <ui:TextBox
            Grid.Row="1"
            Margin="0,14,0,0"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{x:Static res:Strings.OnlineFixes_Search}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            ClearButtonEnabled="True" />

        <!-- 2-Step Guide Banner (Glassmorphic Card) -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="16,12"
            Background="#0AFFFFFF"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Step 1 -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        Background="#1E38bdf8"
                        BorderBrush="#4038bdf8"
                        BorderThickness="1"
                        CornerRadius="11"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <TextBlock
                            Text="1"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#38bdf8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock
                            Text="{x:Static res:Strings.OnlineFixes_Step1_Title}"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Foreground="#f3f4f6" />
                        <TextBlock
                            Text="{x:Static res:Strings.OnlineFixes_Step1_Desc}"
                            FontSize="11.5"
                            Foreground="#9ca3af"
                            TextWrapping="Wrap"
                            Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Divider Line -->
                <Rectangle Grid.Column="1" Fill="#14FFFFFF" VerticalAlignment="Stretch" />

                <!-- Step 2 -->
                <Grid Grid.Column="2" Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        Background="#1E10b981"
                        BorderBrush="#4010b981"
                        BorderThickness="1"
                        CornerRadius="11"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <TextBlock
                            Text="2"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#10b981"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock
                            Text="{x:Static res:Strings.OnlineFixes_Step2_Title}"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Foreground="#f3f4f6" />
                        <TextBlock
                            Text="{x:Static res:Strings.OnlineFixes_Step2_Desc}"
                            FontSize="11.5"
                            Foreground="#9ca3af"
                            TextWrapping="Wrap"
                            Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Loading State -->
        <StackPanel
            Grid.Row="3"
            Margin="0,60,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" FontSize="13" Text="{x:Static res:Strings.OnlineFixes_Loading}" />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel
            Grid.Row="3"
            Margin="0,60,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Search24" FontSize="36" Foreground="#4b5563" HorizontalAlignment="Center" />
            <TextBlock
                Margin="0,10,0,0"
                Foreground="#9ca3af"
                FontSize="13"
                HorizontalAlignment="Center"
                Text="{Binding EmptyMessage}" />
        </StackPanel>

        <!-- Game Cards Grid -->
        <vwp:VirtualizingItemsControl
            Grid.Row="3"
            Margin="0,14,0,0"
            ItemsSource="{Binding Games}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Standard">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OnlineFixGameCardVm}">
                    <Border
                        Width="260"
                        Margin="0,0,14,14"
                        Background="#0DFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Header="{x:Static res:Strings.OnlineFixes_OpenFolder}"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    Command="{Binding PlacementTarget.DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}" />
                                <MenuItem
                                    Header="{x:Static res:Strings.Common_CopyAppId}"
                                    Icon="{ui:SymbolIcon Copy24}"
                                    Command="{Binding PlacementTarget.DataContext.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}" />
                                <MenuItem
                                    Header="{x:Static res:Strings.OnlineFixes_Download}"
                                    Icon="{ui:SymbolIcon Globe24}"
                                    Command="{Binding PlacementTarget.DataContext.DownloadFixCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="122" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cover Image Container -->
                            <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#11FFFFFF">
                                <Grid>
                                    <!-- Fallback Icon while loading -->
                                    <ui:SymbolIcon Symbol="Games24" FontSize="36" Foreground="#20FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- Cover Image -->
                                    <Image Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" Stretch="UniformToFill" />

                                    <!-- Bottom Vignette Gradient for Depth -->
                                    <Border VerticalAlignment="Bottom" Height="40">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#900f172a" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Installed Badge -->
                                    <Border
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Padding="6,2"
                                        Background="#B0000000"
                                        CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Checkmark12" Foreground="#10b981" FontSize="10" Margin="0,0,4,0" />
                                            <TextBlock Text="{x:Static res:Strings.OnlineFixes_InstalledBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#e2e8f0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card Body -->
                            <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    FontSize="13.5"
                                    Foreground="#f3f4f6"
                                    TextTrimming="CharacterEllipsis" />
                                
                                <TextBlock
                                    Text="{Binding AppId, StringFormat='AppID: {0}'}"
                                    Foreground="#9ca3af"
                                    FontSize="11.5"
                                    Margin="0,3,0,10" />

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Content="{x:Static res:Strings.OnlineFixes_Download}"
                                        Icon="{ui:SymbolIcon Globe20}"
                                        Appearance="Secondary"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.DownloadFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                                    <ui:Button
                                        Grid.Column="2"
                                        Content="{x:Static res:Strings.OnlineFixes_Install}"
                                        Appearance="Primary"
                                        Icon="{ui:SymbolIcon FolderZip20}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.InstallFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>
    </Grid>
</UserControl>
