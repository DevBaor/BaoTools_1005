<UserControl
    x:Class="BaoToolsGui.Views.TicketsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TicketsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="8,16,16,24">

                <!-- Header -->
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Tickets_Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="13"
                    Foreground="#9ca3af"
                    Text="{x:Static res:Strings.Tickets_Subtitle}"
                    TextWrapping="Wrap" />

                <!-- Steam Connection Banner -->
                <Border
                    Margin="0,16,0,0"
                    Padding="14,10"
                    Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Running / Not Running Icon -->
                        <ui:SymbolIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{Binding SteamStatusColor}"
                            Symbol="{Binding SteamStatusSymbol}" />

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                FontSize="13"
                                Text="{Binding SteamStatusText}" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="#9ca3af"
                                Text="{Binding SteamStatusHint}" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="2"
                            Appearance="Transparent"
                            Command="{Binding CheckSteamStatusCommand}"
                            ToolTip="{x:Static res:Strings.Tickets_RefreshSteam}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </Grid>
                </Border>

                <!-- Input & Denuvo Filter Card -->
                <Border
                    Margin="0,14,0,0"
                    Padding="18"
                    Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Static res:Strings.Tickets_SelectDenuvoGame}" />
                        <TextBlock
                            Margin="0,2,0,12"
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Tickets_SelectDenuvoGameHint}" />

                        <!-- Denuvo Game Selection Dropdown -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                ItemsSource="{Binding DenuvoGames}"
                                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <Border
                                                Background="#2510b981"
                                                BorderBrush="#4010b981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="Denuvo"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="#10b981" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{Binding AppId, StringFormat=' (ID: {0})'}"
                                                Foreground="#9ca3af"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{Binding DetectionSource, StringFormat=' • {0}'}"
                                                Foreground="#6b7280"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ui:Button
                                Grid.Column="1"
                                Command="{Binding LoadDenuvoGamesCommand}"
                                ToolTip="{x:Static res:Strings.Tickets_RescanGames}"
                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        </Grid>

                        <Border Height="1" Background="#1FFFFFFF" Margin="0,16,0,16" />

                        <!-- Manual AppId input -->
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{x:Static res:Strings.Tickets_ManualAppIdLabel}" />
                        <ui:TextBox
                            Margin="0,6,0,0"
                            PlaceholderText="1361510"
                            Text="{Binding AppIdInput, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Key24}" />

                        <!-- Options Checkboxes -->
                        <StackPanel Margin="0,16,0,0">
                            <CheckBox
                                Content="{x:Static res:Strings.Tickets_Opt_AutoLua}"
                                IsChecked="{Binding AutoApplyToLua, Mode=TwoWay}"
                                Margin="0,0,0,8" />
                            <StackPanel Margin="0,0,0,0">
                                <CheckBox
                                    Content="{x:Static res:Strings.Tickets_Opt_SaveFiles}"
                                    IsChecked="{Binding SaveFiles, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="26,4,0,0"
                                    Text="{x:Static res:Strings.Tickets_Opt_SaveFiles_Hint}"
                                    FontSize="11"
                                    Foreground="#9ca3af"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Button -->
                        <Grid Margin="0,18,0,0">
                            <ui:Button
                                Appearance="Primary"
                                HorizontalAlignment="Left"
                                Command="{Binding ExtractTicketsCommand}"
                                IsEnabled="{Binding CanExtract}"
                                Padding="20,10"
                                Icon="{ui:SymbolIcon ArrowDownload24}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock
                                        Text="{x:Static res:Strings.Tickets_ExtractButton}"
                                        FontWeight="SemiBold"
                                        FontSize="13.5" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <!-- Status Message -->
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="{Binding StatusMessage}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- Results Section (Visible after extraction) -->
                <Border
                    Margin="0,16,0,0"
                    Padding="18"
                    Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasExtracted, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{x:Static res:Strings.Tickets_ResultsHeader}" />

                        <!-- App Ownership Ticket Row -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="#08FFFFFF"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Text="{x:Static res:Strings.Tickets_AppTicket_Title}"
                                            FontWeight="SemiBold"
                                            FontSize="13" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Text="{Binding OwnershipTicketSize, StringFormat='({0} bytes)'}"
                                            Foreground="#9ca3af"
                                            FontSize="12" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Appearance="Secondary"
                                        Command="{Binding CopyAppTicketHexCommand}"
                                        Content="{x:Static res:Strings.Tickets_CopyHex}"
                                        IsEnabled="{Binding HasOwnershipTicket}"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </Grid>
                                <ui:TextBox
                                    Margin="0,8,0,0"
                                    IsReadOnly="True"
                                    Text="{Binding OwnershipTicketHex}"
                                    PlaceholderText="{x:Static res:Strings.Common_NotAvailable}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="11.5" />
                            </StackPanel>
                        </Border>

                        <!-- Encrypted App Ticket (Denuvo) Row -->
                        <Border
                            Margin="0,10,0,0"
                            Padding="12"
                            Background="#08FFFFFF"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Text="{x:Static res:Strings.Tickets_ETicket_Title}"
                                            FontWeight="SemiBold"
                                            FontSize="13" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Text="{Binding EncryptedTicketSize, StringFormat='({0} bytes)'}"
                                            Foreground="#9ca3af"
                                            FontSize="12" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Appearance="Secondary"
                                        Command="{Binding CopyETicketHexCommand}"
                                        Content="{x:Static res:Strings.Tickets_CopyHex}"
                                        IsEnabled="{Binding HasEncryptedTicket}"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </Grid>
                                <ui:TextBox
                                    Margin="0,8,0,0"
                                    IsReadOnly="True"
                                    Text="{Binding EncryptedTicketHex}"
                                    PlaceholderText="{x:Static res:Strings.Common_NotAvailable}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="11.5" />
                            </StackPanel>
                        </Border>

                        <!-- Bottom Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <!-- Export ZIP package button -->
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding ExportZipPackageCommand}"
                                Content="{x:Static res:Strings.Tickets_ExportZip}"
                                Icon="{ui:SymbolIcon Archive24}"
                                Margin="0,0,10,0" />

                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding CopyLuaSnippetCommand}"
                                Content="{x:Static res:Strings.Tickets_CopyLuaCode}"
                                Icon="{ui:SymbolIcon Copy24}"
                                Margin="0,0,10,0" />

                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding OpenSavedFolderCommand}"
                                Content="{x:Static res:Strings.Tickets_OpenFolder}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Visibility="{Binding SavedFolder, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Important Notes & Guidelines Card -->
                <Border
                    Margin="0,16,0,0"
                    Padding="16"
                    Background="#0AFFFFFF"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Info24" Foreground="#38bdf8" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Text="{x:Static res:Strings.Tickets_NoticeHeader}"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Foreground="#38bdf8"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Item 1: Ownership requirement -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Foreground="#10b981" FontSize="15" Margin="0,1,0,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Ownership_Title}" FontWeight="SemiBold" FontSize="12" Foreground="#e5e7eb" />
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Ownership_Desc}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Item 2: 30-minute validity -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Clock24" Foreground="#f59e0b" FontSize="15" Margin="0,1,0,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Validity_Title}" FontWeight="SemiBold" FontSize="12" Foreground="#e5e7eb" />
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Validity_Desc}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Item 3: 5 activations limit -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="People24" Foreground="#a855f7" FontSize="15" Margin="0,1,0,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Limit_Title}" FontWeight="SemiBold" FontSize="12" Foreground="#e5e7eb" />
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Limit_Desc}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Item 4: Steam client active -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Key24" Foreground="#38bdf8" FontSize="15" Margin="0,1,0,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Client_Title}" FontWeight="SemiBold" FontSize="12" Foreground="#e5e7eb" />
                                <TextBlock Text="{x:Static res:Strings.Tickets_Note_Client_Desc}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
