<UserControl
    x:Class="BaoToolsGui.Views.AiChatWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance vm:AiChatViewModel}"
    mc:Ignorable="d">

    <!-- Outer Container (Floating at bottom-right) -->
    <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">

            <!-- ── Chat Popup Window (Flyout) ─────────────────────────────────── -->
            <Border
                x:Name="ChatWindow"
                Width="380"
                Height="520"
                Margin="0,0,0,12"
                Background="{DynamicResource AppCardBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                RenderTransformOrigin="1,1"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ChatTranslate" Y="0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Direction="270" Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Messages + Suggestions -->
                        <RowDefinition Height="Auto" /> <!-- Input -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="13,13,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="14,9" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/AI_img.jpg" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{Binding HeaderStatus}"
                                        FontSize="10.5"
                                        FontWeight="Medium"
                                        Foreground="#34d399"
                                        Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Clear Chat Button -->
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="{Binding ClearChatTooltip}"
                                    Command="{Binding ClearChatCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Close Button -->
                                <Button
                                    Margin="4,0,0,0"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="{Binding CloseTooltip}"
                                    Command="{Binding CloseCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Messages List -->
                    <ScrollViewer x:Name="ChatScroller" Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <!-- User Message Bubble (Right aligned, Accent) -->
                                            <Border
                                                HorizontalAlignment="Right"
                                                Margin="40,0,0,0"
                                                Padding="12,9"
                                                CornerRadius="12"
                                                Background="{DynamicResource AppAccentBrush}"
                                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap"
                                                    FontSize="12.5"
                                                    LineHeight="18"
                                                    Foreground="#FFFFFF" />
                                            </Border>

                                            <!-- AI Message Bubble (Left aligned, Neutral & Rich Copilot) -->
                                            <Border
                                                HorizontalAlignment="Left"
                                                Margin="0,0,32,0"
                                                Padding="12,10"
                                                CornerRadius="12"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel>
                                                    <!-- Optional Diagnosis Title Header -->
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="0,0,0,6"
                                                        BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        Visibility="{Binding HasDiagnosisTitle, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock
                                                            Text="{Binding DiagnosisTitle}"
                                                            FontWeight="Bold"
                                                            FontSize="12.5"
                                                            Foreground="{DynamicResource AppAccentBrush}" />
                                                    </Border>

                                                    <!-- Optional Diagnosis Checklist (✓ / ⚠ / ✗) -->
                                                    <ItemsControl
                                                        ItemsSource="{Binding Checklist}"
                                                        Margin="0,0,0,8"
                                                        Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Margin="0,2,0,2"
                                                                    Padding="8,5"
                                                                    CornerRadius="6"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="18" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Text="{Binding IconText}"
                                                                            FontWeight="Bold"
                                                                            FontSize="12"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#34d399" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                            <Setter Property="Foreground" Value="#fbbf24" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                                            <Setter Property="Foreground" Value="#f87171" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Info">
                                                                                            <Setter Property="Foreground" Value="#60a5fa" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                            <TextBlock
                                                                                Text="{Binding Title}"
                                                                                FontSize="11.5"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                            <TextBlock
                                                                                Text="{Binding Detail}"
                                                                                FontSize="10.5"
                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Main Technical Analysis Text (Rich Markdown with Code Block Styling) -->
                                                    <markdig:MarkdownViewer
                                                        Margin="0,2,0,0"
                                                        Markdown="{Binding Text}"
                                                        PreviewMouseWheel="Markdown_PreviewMouseWheel">
                                                        <markdig:MarkdownViewer.Resources>
                                                            <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
                                                                <Setter Property="FontFamily" Value="Segoe UI" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Setter Property="PagePadding" Value="0" />
                                                            </Style>
                                                            <Style TargetType="{x:Type List}">
                                                                <Setter Property="Margin" Value="18,2,0,4" />
                                                                <Setter Property="Padding" Value="0" />
                                                            </Style>
                                                            <Style TargetType="{x:Type ListItem}">
                                                                <Setter Property="Margin" Value="0,1,0,2" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
                                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                                <Setter Property="LineHeight" Value="18" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                                                                <Setter Property="FontSize" Value="14" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                <Setter Property="Margin" Value="0,6,0,3" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                                                                <Setter Property="FontSize" Value="13" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Setter Property="Margin" Value="0,5,0,2" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Setter Property="Margin" Value="0,4,0,2" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}" TargetType="{x:Type Hyperlink}">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                <Setter Property="TextDecorations" Value="{x:Null}" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                                                <Setter Property="FontFamily" Value="Consolas" />
                                                                <Setter Property="FontSize" Value="11.5" />
                                                                <Setter Property="Foreground" Value="#c4b5fd" />
                                                            </Style>
                                                            <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
                                                                <Setter Property="FontFamily" Value="Consolas" />
                                                                <Setter Property="FontSize" Value="11.5" />
                                                                <Setter Property="Foreground" Value="#e0e7ff" />
                                                                <Setter Property="Background" Value="#1c162e" />
                                                                <Setter Property="Padding" Value="8,6" />
                                                                <Setter Property="Margin" Value="0,4,0,6" />
                                                            </Style>
                                                        </markdig:MarkdownViewer.Resources>
                                                    </markdig:MarkdownViewer>

                                                    <!-- Embedded Interactive Action Buttons -->
                                                    <ItemsControl
                                                        ItemsSource="{Binding ActionButtons}"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding HasActionButtons, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button
                                                                    Margin="0,3,0,3"
                                                                    Padding="10,6"
                                                                    HorizontalAlignment="Stretch"
                                                                    Cursor="Hand"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                                                    BorderThickness="1"
                                                                    Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border
                                                                                            x:Name="ActBd"
                                                                                            Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                            CornerRadius="6"
                                                                                            Padding="{TemplateBinding Padding}">
                                                                                            <TextBlock
                                                                                                Text="{Binding Label}"
                                                                                                FontSize="11.5"
                                                                                                FontWeight="SemiBold"
                                                                                                HorizontalAlignment="Center"
                                                                                                Foreground="{DynamicResource AppAccentBrush}" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="ActBd" Property="Background" Value="#258B5CF6" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Bot Message Action Toolbar (Copy) -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                        <!-- Copy Message Button -->
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTip="{Binding CopyTooltip}"
                                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="CpyBd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="3">
                                                                                    <ui:SymbolIcon Symbol="{Binding CopyIcon}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="CpyBd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Typing / Live Step Progress Indicator -->
                            <StackPanel Orientation="Horizontal" Margin="4,10,0,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing Width="15" Height="15" Foreground="{DynamicResource AppAccentBrush}" IsIndeterminate="True" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding CurrentProgressStep}"
                                    Margin="8,0,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Suggested Questions inside Chat Body -->
                            <StackPanel Margin="0,12,0,4" Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Text="{Binding SuggestionsHeader}"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AppAccentBrush}"
                                    Margin="4,0,0,8" />

                                <ItemsControl ItemsSource="{Binding QuickPrompts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,0,6"
                                                Padding="12,10"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.SendQuickPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border
                                                                        x:Name="CardBd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock
                                                                                x:Name="CardText"
                                                                                Text="{Binding}"
                                                                                FontSize="12"
                                                                                TextWrapping="Wrap"
                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                                VerticalAlignment="Center" />
                                                                            <ui:SymbolIcon
                                                                                Grid.Column="1"
                                                                                x:Name="CardArrow"
                                                                                Symbol="ChevronRight24"
                                                                                FontSize="14"
                                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="8,0,0,0" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                            <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                                            <Setter TargetName="CardArrow" Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Area: Context Chip + Input Bar -->
                    <StackPanel Grid.Row="2">
                        <!-- Active Game Context Tag -->
                        <Border
                            Margin="10,0,10,6"
                            Padding="8,5,6,5"
                            CornerRadius="8"
                            Background="#241B3B"
                            BorderBrush="#508B5CF6"
                            BorderThickness="1"
                            Visibility="{Binding HasActiveContextGame, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{Binding ActiveContextGame.DisplayText}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AppAccentBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{Binding ActiveContextGame.ClearTooltip}"
                                    Command="{Binding ClearActiveContextGameCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ClBd" Background="Transparent" CornerRadius="4">
                                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ClBd" Property="Background" Value="#30FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Input Bar (Cohesive rounded container) -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="4,4,4,4" Margin="10,0,10,10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox
                                    x:Name="InputBox"
                                    Grid.Column="0"
                                    Height="34"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="8,0"
                                    AcceptsReturn="True"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    PlaceholderText="{Binding InputPlaceholder}"
                                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewKeyDown="InputBox_PreviewKeyDown"
                                    KeyDown="InputBox_KeyDown" />

                                <Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Cursor="Hand"
                                    Background="{DynamicResource AppAccentBrush}"
                                    BorderThickness="0"
                                    Foreground="#FFFFFF"
                                    Command="{Binding SendMessageCommand}"
                                    ToolTip="{Binding SendTooltip}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ui:SymbolIcon Symbol="Send24" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="B" Property="Opacity" Value="0.88" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="B" Property="Opacity" Value="0.75" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Rotating Assistant Discovery Speech Bubble ────────────────── -->
            <Button
                x:Name="DiscoveryBubbleButton"
                Margin="0,0,0,6"
                HorizontalAlignment="Right"
                Cursor="Hand"
                Focusable="False"
                Command="{Binding ToggleOpenCommand}"
                Visibility="{Binding IsDiscoveryBubbleVisible, Converter={StaticResource BoolToVis}}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel HorizontalAlignment="Right">
                            <!-- Speech Bubble Body (Auto-fits text snuggly) -->
                            <Border
                                x:Name="BubbleBorder"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="BubbleShadow" BlurRadius="16" ShadowDepth="4" Opacity="0.4" Direction="270" Color="#000000" />
                                </Border.Effect>

                                <!-- Rotating Discovery Text with Smooth Fade + Slide -->
                                <TextBlock
                                    x:Name="DiscoveryText"
                                    Text="{Binding CurrentDiscoveryMessage}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TextTranslate" X="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>

                            <!-- Downward pointer arrow pointing directly to the center of the 48px launcher button (24px from right edge) -->
                            <Path
                                x:Name="BubbleTail"
                                HorizontalAlignment="Right"
                                Margin="0,-1,19,0"
                                Data="M 0,0 L 10,0 L 5,5 Z"
                                Fill="{DynamicResource ControlFillColorDefaultBrush}"
                                Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                                StrokeThickness="0.8"
                                SnapsToDevicePixels="True" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <!-- Hover feedback: slightly brighten bubble and border with theme accent -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="BubbleTail" Property="Fill" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="BubbleTail" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAssistantHovered, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="BubbleBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="BubbleTail" Property="Fill" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="BubbleTail" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ── Floating Circular AI Launcher Button ─────────────────────── -->
            <Button
                x:Name="AiLauncherButton"
                Width="48"
                Height="48"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                Focusable="True"
                TabIndex="0"
                Command="{Binding ToggleOpenCommand}"
                AutomationProperties.Name="{Binding LauncherAccessibilityName}"
                AutomationProperties.HelpText="{Binding LauncherTooltipSubtitle}"
                ToolTipService.InitialShowDelay="300"
                ToolTipService.ShowDuration="8000"
                ToolTipService.BetweenShowDelay="150"
                RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="LauncherNudgeTranslate" Y="0" />
                        <RotateTransform x:Name="LauncherNudgeRotate" Angle="0" />
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.ToolTip>
                    <ToolTip
                        Placement="Top"
                        VerticalOffset="-8"
                        HasDropShadow="True"
                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <ToolTip.Template>
                            <ControlTemplate TargetType="ToolTip">
                                <Border
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Direction="270" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="{Binding LauncherTooltipSubtitle}"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </ToolTip.Template>
                    </ToolTip>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 0. High-Tech Theme Glow Aura (Pulses when speaking & glows on hover) -->
                            <Border
                                x:Name="LauncherGlowAura"
                                Width="46"
                                Height="46"
                                CornerRadius="23"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Opacity="0"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AuraScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <BlurEffect Radius="16" KernelType="Gaussian" />
                                </Border.Effect>
                            </Border>

                            <!-- Main Circular Button Body -->
                            <Border
                                x:Name="LauncherBorder"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LauncherScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="LauncherShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.4" Direction="270" Color="#000000" />
                                </Border.Effect>

                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 1. Robot / Assistant Icon (Closed state) -->
                                    <Border
                                        x:Name="RobotIconView"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding DataContext.IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="pack://application:,,,/AI_img.jpg" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <!-- 2. Close / X Icon (Open state) -->
                                    <ui:SymbolIcon
                                        x:Name="CloseIconView"
                                        Symbol="Dismiss20"
                                        FontSize="18"
                                        Foreground="#FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding DataContext.IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Notification Badge [ 🤖 ¹ ] -->
                            <Border
                                x:Name="NotificationBadge"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Height="18"
                                MinWidth="18"
                                CornerRadius="9"
                                Background="#EF4444"
                                BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="2"
                                Padding="4,0"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding DataContext.HasNotification, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Text="{Binding DataContext.UnreadCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hide glow aura when chat flyout is open -->
                            <DataTrigger Binding="{Binding DataContext.IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="LauncherGlowAura" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <!-- Subtle Hover: scale up slightly, theme accent border, soft aura glow -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LauncherGlowAura" Property="Opacity" Value="0.45" />
                                <Setter TargetName="LauncherBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="LauncherBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="LauncherBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAssistantHovered, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="LauncherGlowAura" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LauncherBorder" Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                                <Setter TargetName="LauncherBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Keyboard Focus Accessibility -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LauncherBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="LauncherBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
